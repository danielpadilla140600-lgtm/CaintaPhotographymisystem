# Railway MySQL / runtime
DB_HOST=your-railway-db-host.internal
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=cainta_photography_mis
ALLOW_LOCAL_BACKUP=false

# App runtime
VERCEL=1
NODE_ENV=production
FRONTEND_ORIGINS=https://your-app.vercel.app

# Optional but recommended
GEMINI_API_KEY=your_gemini_api_key_here
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_google_app_password

# Optional custom email sender
EMAIL_FROM=your_email@gmail.com

# ─── GCash / PayMongo QR Payment Integration ───────────────────────
# Sign up at https://dashboard.paymongo.com → Developers → API Keys
PAYMONGO_SECRET_KEY=sk_test_placeholder_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_placeholder_public_key
# Get from PayMongo Dashboard → Developers → Webhooks → Create Webhook
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Switch to 'live' when going to production
PAYMONGO_MODE=sandbox

# Encryption key for studio payment credentials (32 random hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=your_32_byte_hex_key_here_64_chars_total
