# Railway MySQL / runtime
DB_HOST=your-railway-db-host.internal
DB_PORT=""
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=""
ALLOW_LOCAL_BACKUP=false

# App runtime
VERCEL=1
NODE_ENV=production
FRONTEND_ORIGINS=FRONTEND_ORIGINS=https://one-cainta-photography-mis.web.app


# Optional but recommended
GEMINI_API_KEY=""

# ── Email / SMTP ────────────────────────────────────────────────────────────
# Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
SMTP_EMAIL=""
SMTP_APP_PASSWORD=""

# Optional: override host/port to use a different SMTP provider instead of Gmail.
# Gmail defaults (SSL):     SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# Gmail STARTTLS:           SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# SendGrid:                 SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURE=false  SMTP_EMAIL=apikey  SMTP_APP_PASSWORD=<SG.xxx>
# Mailgun:                  SMTP_HOST=smtp.mailgun.org   SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Display name shown in email "From" header (optional, defaults to "Cainta Photography Studio MIS")
EMAIL_FROM_NAME="Cainta Photography Studio MIS"

# ─── GCash / PayMongo QR Payment Integration ───────────────────────
# Sign up at https://dashboard.paymongo.com → Developers → API Keys
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
# Get from PayMongo Dashboard → Developers → Webhooks → Create Webhook
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Switch to 'live' when going to production
PAYMONGO_MODE=sandbox

# Encryption key for studio payment credentials (32 random hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=your_32_byte_hex_key_here_64_chars_total
