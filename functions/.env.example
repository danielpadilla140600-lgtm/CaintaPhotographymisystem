# ==============================================================================
# FIREBASE CLOUD FUNCTIONS BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to functions/.env and supply your production values.
# Firebase automatically loads functions/.env during 'firebase deploy'.

# ── Cloud MySQL Database Credentials ──────────────────────────────────────────
# Point to your external cloud MySQL (Google Cloud SQL, Aiven, Railway, TiDB)
DB_HOST=junction.proxy.rlwy.net
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_cloud_mysql_password
DB_NAME=cainta_photography_mis
DB_SSL=true
DB_CONNECTION_LIMIT=3
ALLOW_LOCAL_BACKUP=false

# ── Runtime & Origins ────────────────────────────────────────────────────────
NODE_ENV=production
# When using Firebase Hosting with rewrites, requests come directly from the same domain:
FRONTEND_ORIGINS=https://one-cainta-photography-mis.web.app,https://one-cainta-photography-mis.firebaseapp.com

# ── Optional External Integrations ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_google_app_password
EMAIL_FROM="Cainta Photography MIS" <your_email@gmail.com>

# ── GCash / PayMongo Payments ────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_live_or_test_xxxx
PAYMONGO_PUBLIC_KEY=pk_live_or_test_xxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxx
PAYMONGO_MODE=sandbox
