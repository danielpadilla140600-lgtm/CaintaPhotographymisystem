{
  "name": "cainta-mis-backend-functions",
  "description": "Firebase Cloud Functions backend for Cainta Photography Studio MIS",
  "version": "1.0.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --packages=external --sourcemap",
    "build:watch": "npm run build -- --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "jspdf": "^4.2.1",
    "mysql2": "^3.23.4",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  },
  "private": true
}
