# ==============================================================================
# FIREBASE CLOUD FUNCTIONS BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to functions/.env and supply your production values.
# Firebase automatically loads functions/.env during 'firebase deploy'.

# ── Cloud MySQL Database Credentials ──────────────────────────────────────────
# Point to your external cloud MySQL (Google Cloud SQL, Aiven, Railway, TiDB)
DB_HOST=junction.proxy.rlwy.net
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_cloud_mysql_password
DB_NAME=cainta_photography_mis
DB_SSL=true
DB_CONNECTION_LIMIT=3
ALLOW_LOCAL_BACKUP=false

# ── Runtime & Origins ────────────────────────────────────────────────────────
NODE_ENV=production
# When using Firebase Hosting with rewrites, requests come directly from the same domain:
FRONTEND_ORIGINS=https://one-cainta-photography-mis.web.app,https://one-cainta-photography-mis.firebaseapp.com

# ── Optional External Integrations ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Gmail: enable 2FA → generate App Password at myaccount.google.com/apppasswords
# IMPORTANT for Firebase Functions (Blaze plan required for outbound SMTP):
#   Set these vars here (functions/.env), NOT in the root .env.
#   Deploy with: firebase deploy --only functions
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_google_app_password

# Optional: override SMTP host/port to use a different provider instead of Gmail.
# Gmail SSL (default):  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# Gmail STARTTLS:       SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# SendGrid:             SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURE=false
#                       SMTP_EMAIL=apikey  SMTP_APP_PASSWORD=SG.xxxx
# Mailgun:              SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Display name in the email "From" header
EMAIL_FROM_NAME=Cainta Photography Studio MIS

# ── GCash / PayMongo Payments ────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_live_or_test_xxxx
PAYMONGO_PUBLIC_KEY=pk_live_or_test_xxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxx
PAYMONGO_MODE=sandbox
